# Base URL of the Django REST backend.
# Local dev: http://127.0.0.1:8000  |  Production: https://source.endovillehealth.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth client ID used by the sign-in button on /login and /signup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Soft geo-block: when "true", visitors outside Kenya (KE) and USA (US) are
# redirected to /unavailable. Leave unset/false for local development.
# On Netlify production this is set via netlify.toml (GEO_BLOCK_ENABLED=true).
# Local test: GEO_BLOCK_ENABLED=true and send header x-geo-country: FR|US|KE
GEO_BLOCK_ENABLED=false
